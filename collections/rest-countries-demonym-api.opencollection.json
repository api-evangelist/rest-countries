{
  "opencollection": "1.0.0",
  "info": {
    "name": "REST Countries All Demonym API",
    "version": "3.1"
  },
  "items": [
    {
      "info": {
        "name": "Demonym",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Countries By Demonym",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://restcountries.com/v3.1/demonym/:demonym",
            "params": [
              {
                "name": "demonym",
                "value": "",
                "type": "path",
                "description": "Demonym (citizen designation)."
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to return on each country. Up to 10 fields may be requested. Required on `/all`."
              }
            ]
          },
          "docs": "Search countries by the demonym used for their inhabitants (e.g. `french`, `peruvian`)."
        }
      ]
    }
  ],
  "bundled": true
}