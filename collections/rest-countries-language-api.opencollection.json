{
  "opencollection": "1.0.0",
  "info": {
    "name": "REST Countries All Language API",
    "version": "3.1"
  },
  "items": [
    {
      "info": {
        "name": "Language",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Countries By Language",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://restcountries.com/v3.1/lang/:language",
            "params": [
              {
                "name": "language",
                "value": "",
                "type": "path",
                "description": "ISO 639 language code or language name."
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to return on each country. Up to 10 fields may be requested. Required on `/all`."
              }
            ]
          },
          "docs": "Search countries by ISO 639 language code or language name (e.g. `spanish`, `cym`)."
        }
      ]
    }
  ],
  "bundled": true
}