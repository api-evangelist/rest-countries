{
  "opencollection": "1.0.0",
  "info": {
    "name": "REST Countries All Subregion API",
    "version": "3.1"
  },
  "items": [
    {
      "info": {
        "name": "Subregion",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Countries By Subregion",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://restcountries.com/v3.1/subregion/:subregion",
            "params": [
              {
                "name": "subregion",
                "value": "",
                "type": "path",
                "description": "UN subregion name."
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to return on each country. Up to 10 fields may be requested. Required on `/all`."
              }
            ]
          },
          "docs": "Filter countries by UN demographic subregion (e.g. `northern europe`, `southern asia`)."
        }
      ]
    }
  ],
  "bundled": true
}