{
  "opencollection": "1.0.0",
  "info": {
    "name": "REST Countries All Region API",
    "version": "3.1"
  },
  "items": [
    {
      "info": {
        "name": "Region",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Countries By Region",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://restcountries.com/v3.1/region/:region",
            "params": [
              {
                "name": "region",
                "value": "",
                "type": "path",
                "description": "UN region name."
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to return on each country. Up to 10 fields may be requested. Required on `/all`."
              }
            ]
          },
          "docs": "Filter countries by UN demographic region (e.g. `europe`, `asia`, `africa`, `americas`, `oceania`)."
        }
      ]
    }
  ],
  "bundled": true
}